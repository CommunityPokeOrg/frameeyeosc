# Copy to ~/.config/frameeyeosc/env and edit. Options: frameeyeosc --help
# With no --target, OSC goes to the PC that Steam Link is streaming from (port 9000).
# Examples:
#   FRAMEEYEOSC_ARGS="--lid-scale-right 1.06"          # even out a right eye that opens less
#   FRAMEEYEOSC_ARGS="--target 192.168.1.10:9000"      # fixed destination instead of auto
FRAMEEYEOSC_ARGS=""
